{
	"name": "octree-workspace",
	"private": true,
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=12 <13",
			"onFail": "error"
		}
	},
	"scripts": {
		"build": "pnpm -r build",
		"lint": "pnpm -r lint",
		"format": "pnpm -r format",
		"test": "pnpm -r test",
		"prewatch": "pnpm --filter sparse-octree run build:js",
		"watch": "pnpm -r --parallel watch",
		"start": "pnpm --filter sparse-octree-demo start"
	}
}
