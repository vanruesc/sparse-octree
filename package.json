{
	"name": "octree-workspace",
	"private": true,
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=12 <13",
			"onFail": "error"
		}
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"del-cli": "catalog:",
		"esbuild": "catalog:",
		"eslint": "catalog:",
		"eslint-config-aether": "catalog:",
		"npm-run-all": "catalog:",
		"typescript": "catalog:"
	},
	"scripts": {
		"build": "pnpm -r build",
		"lint": "pnpm -r lint",
		"format": "pnpm -r format",
		"test": "pnpm -r test",
		"watch": "pnpm -r --parallel watch"
	}
}
