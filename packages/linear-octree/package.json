{
	"name": "linear-octree",
	"version": "0.3.2",
	"description": "A sparse, linear octree data structure.",
	"license": "Zlib",
	"author": {
		"name": "Raoul van Rüschen",
		"email": "vanruesc@outlook.de"
	},
	"homepage": "https://github.com/vanruesc/sparse-octree/tree/main/packages/linear-octree",
	"repository": {
		"url": "git+https://github.com/vanruesc/sparse-octree.git",
		"directory": "packages/linear-octree"
	},
	"bugs": {
		"url": "https://github.com/vanruesc/sparse-octree/issues"
	},
	"keywords": [
		"3d",
		"spatial",
		"partition",
		"subdivision",
		"hierarchy",
		"voxel",
		"points",
		"frustum",
		"culling",
		"raycasting"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"sparse-octree": "workspace:7.x.x"
	},
	"peerDependencies": {
		"three": "catalog:peers"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/three": "catalog:",
		"three": "catalog:",
		"typedoc": "catalog:",
		"typedoc-plugin-mdn-links": "catalog:"
	},
	"scripts": {
		"watch": "run-p watch:*",
		"watch:js": "node build.js -w",
		"watch:tsc": "tsc -p tsconfig.d.json --watch --preserveWatchOutput",
		"build": "run-p build:*",
		"build:js": "node build.js",
		"build:tsc": "tsc -p tsconfig.d.json",
		"build:doc": "typedoc --tsconfig tsconfig.d.json --plugin typedoc-plugin-mdn-links",
		"lint": "eslint src test",
		"format": "eslint --fix src test",
		"pretest": "run-s clean lint build",
		"test": "node --test",
		"clean": "del-cli dist public",
		"deploy": "pnpm run move",
		"move": "node move.js",
		"prepublishOnly": "run-s test"
	}
}
